function UI.searchRun(text)
	Fn.setStatus(L("searchingMsg"), IC.soft)
	Fn.setProgress(0.2)
	local id, name = Fn.resolveUser(text)
	if not id then
		Fn.setStatus(name, T.red)
		Fn.setProgress(0)
		busy = false
		return false
	end

	pendingId = id
	preview.Image = ""
	preview.ImageTransparency = 0
	previewHint.Text = L("loadingMsg")
	previewHint.Visible = true
	task.spawn(function()
		local img = Fn.getThumb(id, Enum.ThumbnailType.AvatarThumbnail, Enum.ThumbnailSize.Size420x420)
		if pendingId == id then
			if img then
				preview.ImageTransparency = 1
				preview.Image = img
				tween(preview, TweenInfo.new(0.25, Enum.EasingStyle.Quad), { ImageTransparency = 0 })
			else
				preview.Image = ""
			end
			previewHint.Text = L("noProfile")
			previewHint.Visible = not img
		end
	end)

	local desc
	for _ = 1, 3 do
		local ok, d = pcall(Players.GetHumanoidDescriptionFromUserId, Players, id)
		if ok and d then
			desc = d
			break
		end
		task.wait(0.3)
	end
	if not desc then
		Fn.setStatus(L("noAvatarMsg"), T.red)
		Fn.setProgress(0)
		busy = false
		return false
	end

	local display = name
	do
		local okI, infos = pcall(function()
			return game:GetService("UserService"):GetUserInfosByUserIdsAsync({ id })
		end)
		local inf = okI and type(infos) == "table" and infos[1]
		if inf and type(inf.DisplayName) == "string" and inf.DisplayName ~= "" then
			display = inf.DisplayName
		end
	end
	current = { id = id, name = name, display = display, desc = desc }
	do
		local function esc(t) return (t:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")) end
		nameLabel.Text = esc(display) .. '\n<font color="rgb(176,168,152)" size="11">@' .. esc(name) .. "</font>"
	end
	idLabel.Text = "ID: " .. tostring(id)
	Fn.setStatus(L("readyMsg"), T.green)
	Fn.setProgress(1)
	task.delay(0.6, function() Fn.setProgress(0) end)

	if All.on then
		All.announce = true
		if UI.AllSync then UI.AllSync() end
	end

	Fn.ensureBuild(current)

	busy = false
	return true
end

function Fn.search(text)
	if busy then return false end
	busy = true
	local ok, res = pcall(UI.searchRun, text)
	busy = false
	if not ok then
		Fn.setStatus("Error: " .. tostring(res), T.red)
		Fn.setProgress(0)
		return false
	end
	return res
end

function Fn.applyAvatar(entry)
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hum or not hrp then return false, L("noCharMsg") end
	local rig = hum.RigType

	local b = Fn.ensureBuild(entry)
	if not b then return false, L("noCharMsg") end

	if b.state == "building" then
		Fn.setStatus(L("loadingMsg"), IC.soft)
		local t0 = os.clock()
		while b.state == "building" do
			Fn.setProgress(math.min(0.85, 0.15 + (os.clock() - t0) / 20))
			task.wait(0.1)
		end
	end
	if b.state ~= "ready" or not b.template then
		Build[entry.id] = nil
		local i = table.find(BuildOrder, entry.id)
		if i then table.remove(BuildOrder, i) end
		return false, L("noAvatarShell")
	end
	local template, mode = b.template, b.mode
	Fn.setProgress(0.9)

	char = LocalPlayer.Character
	hum = char and char:FindFirstChildOfClass("Humanoid")
	hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hum or not hrp then return false, L("charChangedMsg") end

	State.template = template

	Fn.setStatus(L("applyingMsg"), IC.soft)

	local ok, err = Fn.mount(char, hum, template)
	if not ok then return false, tostring(err) end
	State.copyEntry = entry

	Fn.setProgress(1)
	task.delay(0.6, function() Fn.setProgress(0) end)

	local note = ""
	if rig ~= Enum.HumanoidRigType.R15 then note = note .. " | R6" end
	if mode == "assets" then note = note .. " | basico" end
	local missing = Fn.verifyShell(char)
	if #missing > 0 then
		note = note .. " | " .. #missing .. " avisos"
	end
	return true, note
end

function Fn.restoreAvatar()
	Fn.unmount()
	State.template, State.copyEntry = nil, nil
end

function Fn.copyCurrent()
	if applying then return end
	if not current then Fn.setStatus(L("firstSearchMsg"), T.warn) return end
	applying = true
	local cur = current
	Fn.setStatus(L("copyingMsg"), IC.soft)
	local ok, success, info = pcall(Fn.applyAvatar, cur)
	if not ok then
		Fn.setStatus("Error: " .. tostring(success), T.red)
		Fn.setProgress(0)
	elseif success then
		Fn.setStatus(L("copiedMsg") .. cur.name .. info, T.green)
		if UI.AllSync then UI.AllSync() end
	else
		Fn.setStatus(tostring(info), T.red)
		Fn.setProgress(0)
	end
	applying = false
end

track(LocalPlayer.CharacterAdded:Connect(function(char)
