			BackgroundTransparency = 0.15, BorderSizePixel = 0, ZIndex = 21,
		})
		corner(gripBars[#gripBars], 1)
	end

	local function paintGrip(color)
		for _, bar in ipairs(gripBars) do
			tween(bar, TweenInfo.new(0.12), { BackgroundColor3 = color })
		end
	end

	function Fn.setScale(b)
		local vp = UI.viewport()
		local maxB = math.min(2, (vp.X - Root.Position.X.Offset) / W, (vp.Y - Root.Position.Y.Offset) / H)
		b = math.clamp(b, MIN_SCALE, math.max(MIN_SCALE, maxB))
		BASE = b
		Root.Size = UDim2.fromOffset(W * BASE, H * BASE)
		winScale.Scale = BASE
	end

	local resizing, active, startPos, startBase = false, nil, nil, 1
	track(grip.InputBegan:Connect(function(inp)
		if inp.UserInputType == Enum.UserInputType.MouseButton1
			or inp.UserInputType == Enum.UserInputType.Touch then
			resizing, active, startPos, startBase = true, inp, inp.Position, BASE
			paintGrip(IC.gold)
			local c
			c = inp.Changed:Connect(function()
				if inp.UserInputState == Enum.UserInputState.End then
					c:Disconnect()
					resizing = false
					paintGrip(IC.soft)
				end
			end)
		end
	end))
	track(UIS.InputChanged:Connect(function(inp)
		if not resizing then return end
		if inp.UserInputType == Enum.UserInputType.MouseMovement or inp == active then
			local d = inp.Position - startPos
			Fn.setScale(startBase + (d.X / W + d.Y / H) / 2)
		end
	end))
