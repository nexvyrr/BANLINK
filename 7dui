function Fn.templateFromAssets(desc, char)
	local base
	local okc = pcall(function()
		char.Archivable = true
		for _, d in ipairs(char:GetDescendants()) do
			pcall(function() d.Archivable = true end)
		end
		for inst, t in pairs(State.hidden) do
			if inst.Parent then inst.Transparency = t end
		end
		base = char:Clone()
		for inst in pairs(State.hidden) do
			if inst.Parent then inst.Transparency = 1 end
		end
	end)
	if not okc or not base then return nil end

	for _, d in ipairs(base:GetDescendants()) do
		if d:IsA("LuaSourceContainer") or d:IsA("Tool") or d:IsA("Accoutrement")
			or d:IsA("CharacterAppearance") or d:IsA("BillboardGui") or d:IsA("SurfaceGui")
			or d:IsA("Highlight") or d:IsA("ForceField") then
			pcall(function() d:Destroy() end)
		end
	end

	local src = Fn.buildFromAssets(desc)
	for _, c in ipairs(src:GetChildren()) do
		if c:IsA("CharacterAppearance") then c.Parent = base end
	end
	local head = base:FindFirstChild("Head")
	local face = src:FindFirstChild("face")
	if head and face then
		for _, d in ipairs(head:GetChildren()) do
			if d:IsA("Decal") then d:Destroy() end
		end
		face.Parent = head
	end
	for _, a in ipairs(src:GetChildren()) do
		if a:IsA("Accoutrement") then Fn.attachByAttachments(base, a) end
	end
	pcall(function() src:Destroy() end)
	return base
end

function Fn.lowestLeg(model)
	local root = model:FindFirstChild("HumanoidRootPart")
	if not root then return nil end
	local cf = { [root] = CFrame.identity }
	local joints = {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("Motor6D") and d.Part0 and d.Part1 then joints[#joints + 1] = d end
	end
	local changed, guard = true, 0
	while changed and guard < 30 do
		changed = false
		guard = guard + 1
		for _, j in ipairs(joints) do
			local a, b = j.Part0, j.Part1
			if cf[a] and not cf[b] then
				cf[b] = cf[a] * j.C0 * j.C1:Inverse()
				changed = true
			elseif cf[b] and not cf[a] then
				cf[a] = cf[b] * j.C1 * j.C0:Inverse()
				changed = true
			end
		end
	end
	local low
	for p, c in pairs(cf) do
		if Fn.LEG_NAMES[p.Name] and p.Parent == model then
			local s = p.Size
			local ext = 0.5 * (math.abs(c.RightVector.Y) * s.X + math.abs(c.UpVector.Y) * s.Y + math.abs(c.LookVector.Y) * s.Z)
			local y = c.Position.Y - ext
			if not low or y < low then low = y end
		end
	end
	return low
end

local Rig = {}

function Rig.transform(rm)
	local p0, p1 = rm.Part0, rm.Part1
	if p0 and p1 then
		return (p0.CFrame * rm.C0):Inverse() * (p1.CFrame * rm.C1)
	end
	return rm.Transform
end

function Rig.pose(list)
	for _, pr in ipairs(list) do
		local rm, sm, base = pr[1], pr[2], pr[3]
		if rm.Parent and sm.Parent then
			local ok, tr = pcall(Rig.transform, rm)
			if ok and tr then sm.C0 = base * tr end
		end
	end
end

function Rig.reset(list)
	for _, pr in ipairs(list) do
		if pr[2].Parent then pr[2].C0 = pr[3] end
	end
end

function Rig.pairs(char, shell)
	local list = {}
	for _, rm in ipairs(char:GetDescendants()) do
		if rm:IsA("Motor6D") and rm.Parent and rm.Parent.Parent == char then
			local sp = shell:FindFirstChild(rm.Parent.Name)
			local sm = sp and sp:FindFirstChild(rm.Name)
			if sm and sm:IsA("Motor6D") then
				list[#list + 1] = { rm, sm, sm.C0 }
			end
		end
	end
	return list
end

function Rig.offset(char, shell)
	local dy = 0
	local lowR, lowS = Fn.lowestLeg(char), Fn.lowestLeg(shell)
	if lowR and lowS then dy = math.clamp(lowR - lowS, -8, 8) end
	return CFrame.new(0, dy, 0)
end

function Rig.animator(shell)
	local sh = shell:FindFirstChildOfClass("Humanoid")
	if not sh then return nil end
	pcall(function() sh.WalkSpeed = 0 end)
	pcall(function() sh.JumpPower = 0 end)
	pcall(function() sh.AutoRotate = false end)
	local a = sh:FindFirstChildOfClass("Animator")
	if not a then
		a = Instance.new("Animator")
		a.Parent = sh
	end
	return a
end

function Rig.parts(shell)
	local parts = {}
	for _, d in ipairs(shell:GetDescendants()) do
		if d:IsA("BasePart") then
			pcall(function()
				d.CanCollide = false
				d.CanTouch = false
				d.CanQuery = false
				d.Massless = true
			end)
			parts[#parts + 1] = d
		end
	end
	return parts
end

Rig.extra = setmetatable({}, { __mode = "k" })

function Rig.extraOf(mirror)
	local ex = Rig.extra[mirror]
	if not ex then
		ex = {
			replaced = setmetatable({}, { __mode = "k" }),
			born = setmetatable({}, { __mode = "k" }),
			key = setmetatable({}, { __mode = "k" }),
			bad = {},
		}
		Rig.extra[mirror] = ex
	end
	return ex
end

function Rig.locoMap(char)
	local map = {}
	local an = char and char:FindFirstChild("Animate")
	if not an then return map end
	for _, key in ipairs({ "idle", "walk", "run", "jump", "fall", "climb", "swim", "swimidle" }) do
		local f = an:FindFirstChild(key)
		if f then
			for _, a in ipairs(f:GetDescendants()) do
				if a:IsA("Animation") then
					local n = tostring(a.AnimationId):match("%d+")
					if n then map[n] = key end
				end
			end
		end
	end
	return map
end

function Rig.mirror(char, sAnim, mirror, rep)
	if not char or not sAnim or not sAnim.Parent then return false end
	local ex = Rig.extraOf(mirror)
	local sig = rep and rep.sig or "plain"
	if ex.sig ~= sig then
		for k, st in pairs(mirror) do
			pcall(function() st:Stop(0.1) end)
			mirror[k] = nil
		end
		ex.replaced = setmetatable({}, { __mode = "k" })
		ex.born = setmetatable({}, { __mode = "k" })
		ex.key = setmetatable({}, { __mode = "k" })
		ex.bad = {}
		ex.sig = sig
	end
	local rHum = char:FindFirstChildOfClass("Humanoid")
	local rAnim = rHum and rHum:FindFirstChildOfClass("Animator")
	if not rAnim then return false end
	local okT, tracks = pcall(function() return rAnim:GetPlayingAnimationTracks() end)
	if not okT or type(tracks) ~= "table" then return false end

	local seen, count = {}, 0
	local now = os.clock()
	for _, rt in ipairs(tracks) do
		local anim = rt.Animation
		if anim and anim.AnimationId ~= "" then
			seen[rt] = true
			local m = mirror[rt]
			if not m then
				local useAnim, replaced, key = anim, false, nil
				if rep and rep.keyOf then
					key = rep.keyOf(anim)
					local g = key and rep.get(key)
					if g then useAnim, replaced = g, true end
				end
				local ok, st = pcall(function() return sAnim:LoadAnimation(useAnim) end)
				if ok and st then
					if replaced then
						ex.replaced[rt] = true
						ex.born[rt] = now
						ex.key[rt] = key
					end
					m = st
					mirror[rt] = st
					pcall(function()
						st.Priority = rt.Priority
						st.Looped = rt.Looped
						st:Play(0.1, math.max(rt.WeightCurrent, 0.01), rt.Speed)
					end)
				end
			end
			if m and ex.replaced[rt] then
				local okL, len = pcall(function() return m.Length end)
				if okL and len == 0 and now - (ex.born[rt] or now) > 2.5 then
					if ex.key[rt] then ex.bad[ex.key[rt]] = true end
					ex.replaced[rt] = nil
					pcall(function() m:Stop(0.1) end)
					mirror[rt] = nil
					m = nil
				end
			end
			if m then
				pcall(function()
					if not m.IsPlaying then
						m:Play(0.1, math.max(rt.WeightCurrent, 0.01), rt.Speed)
					end
					m.Priority = rt.Priority
					m.Looped = rt.Looped
					m:AdjustWeight(math.max(rt.WeightCurrent, 0.01), 0)
					m:AdjustSpeed(rt.Speed)
					local len = rt.Length
					if len and len > 0 and not ex.replaced[rt] then
						local d = math.abs(m.TimePosition - rt.TimePosition)
						if rt.Looped then d = math.min(d, len - d) end
						if d > 0.25 then m.TimePosition = rt.TimePosition end
					end
				end)
				count = count + 1
			end
		end
	end

	for rt, st in pairs(mirror) do
		if not seen[rt] then
			pcall(function() st:Stop(0.1) end)
			mirror[rt] = nil
		end
	end
	return count > 0
end

function Fn.hideReal(char, hidden)
	local function hide(p)
		if hidden[p] == nil then hidden[p] = p.Transparency end
		if p.Transparency ~= 1 then p.Transparency = 1 end
	end
	for _, c in ipairs(char:GetChildren()) do
		if c:IsA("BasePart") and c.Name ~= "HumanoidRootPart" then
			hide(c)
		elseif c:IsA("Accoutrement") then
			for _, d in ipairs(c:GetDescendants()) do
				if d:IsA("BasePart") then hide(d) end
			end
		end
	end
end

function Fn.setShellLTM(v)
	for _, p in ipairs(State.shellParts) do
		pcall(function() p.LocalTransparencyModifier = v end)
	end
end

function Fn.unmount()
	for _, c in ipairs(State.conns) do pcall(function() c:Disconnect() end) end
	State.conns = {}
	if State.shell then
		pcall(function() State.shell:Destroy() end)
	end
	for inst, t in pairs(State.hidden) do
		if inst.Parent then pcall(function() inst.Transparency = t end) end
	end
	State.shell, State.sRoot, State.char = nil, nil, nil
	State.shellParts, State.hidden, State.pairList = {}, {}, {}
	State.mirror, State.sAnimator, State.animActive, State.c0Dirty = {}, nil, false, false
	State.fp = false
end

function Fn.noCollide()
	for _, p in ipairs(State.shellParts) do
		if p.CanCollide then p.CanCollide = false end
		if p.CanTouch then p.CanTouch = false end
		if p.CanQuery then p.CanQuery = false end
	end
end

function Fn.syncPose()
	if not State.shell or not State.char or not State.char.Parent then return end
	if State.animActive then
		if State.c0Dirty then
			Rig.reset(State.pairList)
			State.c0Dirty = false
		end
		return
	end
	Rig.pose(State.pairList)
	State.c0Dirty = true
end

function Fn.onStep()
	local shell, char, sRoot = State.shell, State.char, State.sRoot
	if not shell or not char or not sRoot or not char.Parent then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	local want = workspace.CurrentCamera or workspace
	if shell.Parent ~= want then shell.Parent = want end

	for inst in pairs(State.hidden) do
		if inst.Parent and inst.Transparency ~= 1 then inst.Transparency = 1 end
	end

	Fn.noCollide()

	sRoot.CFrame = hrp.CFrame * State.offset

	State.animActive = Rig.mirror(char, State.sAnimator, State.mirror, nil)
	Fn.syncPose()

	local now = os.clock()
	if now - State.lastScan > 0.3 then
		State.lastScan = now
		Fn.hideReal(char, State.hidden)
	end

	local cam = workspace.CurrentCamera
	local head = char:FindFirstChild("Head")
	if cam and head then
		local fp = (cam.CFrame.Position - head.Position).Magnitude < 1.6
		if fp ~= State.fp then
			State.fp = fp
			Fn.setShellLTM(fp and 1 or 0)
		end
	end
end

function Fn.mount(char, hum, template)
	Fn.unmount()
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then return false, L("noCharMsg") end

	local shell = template:Clone()
	shell.Name = SHELL_NAME
	local sRoot = shell:FindFirstChild("HumanoidRootPart")
	if not sRoot then
		shell:Destroy()
		return false, L("noShellRootMsg")
	end

	local sAnimator = Rig.animator(shell)
	local list = Rig.pairs(char, shell)

	State.offset = Rig.offset(char, shell)
	sRoot.Anchored = true
	shell.PrimaryPart = sRoot
	shell:PivotTo(hrp.CFrame * State.offset)

	local parts = Rig.parts(shell)

	State.shell, State.sRoot, State.char = shell, sRoot, char
	State.sAnimator, State.mirror, State.animActive, State.c0Dirty = sAnimator, {}, false, false
	State.shellParts, State.pairList = parts, list
	State.fp = false
	shell.Parent = workspace.CurrentCamera or workspace

	Fn.hideReal(char, State.hidden)
	State.lastScan = os.clock()
	State.conns[#State.conns + 1] = RunService.RenderStepped:Connect(Fn.onStep)
	State.conns[#State.conns + 1] = RunService.Stepped:Connect(function()
		Fn.noCollide()
		Fn.syncPose()
	end)
	State.conns[#State.conns + 1] = RunService.Heartbeat:Connect(function()
		Fn.noCollide()
		Fn.syncPose()
	end)
	return true
end

function Fn.verifyShell(char)
	local missing = {}
	local shell = State.shell
	if not shell then return { "sin modelo" } end
	for _, c in ipairs(char:GetChildren()) do
		if c:IsA("BasePart") and Fn.STD_PARTS[c.Name] and not shell:FindFirstChild(c.Name) then
			missing[#missing + 1] = c.Name
		end
	end
	if #State.pairList == 0 then missing[#missing + 1] = "uniones" end
	return missing
end

function Fn.ensureDescriptionAccessories(template, desc)
	if not template or not desc then return 0 end
	local okList, accessories = pcall(function() return desc:GetAccessories(true) end)
	if not okList or type(accessories) ~= "table" or #accessories == 0 then return 0 end

	local hum = template:FindFirstChildOfClass("Humanoid")
	if not hum then return 0 end

	local present = {}
	for _, item in ipairs(template:GetDescendants()) do
		if item:IsA("Accessory") then present[item.Name] = true end
	end

	local added = 0
	for _, info in ipairs(accessories) do
		local assetId = tonumber(info.AssetId)
		if assetId and assetId > 0 then
			local loaded = Fn.loadAsset(assetId)
			local accessory = Fn.findClass(loaded, "Accessory")
			if accessory then
				if not present[accessory.Name] then
					local wrap = accessory:FindFirstChildWhichIsA("WrapLayer", true)
					if wrap then
						if info.Order ~= nil then pcall(function() wrap.Order = info.Order end) end
						if info.Puffiness ~= nil then pcall(function() wrap.Puffiness = info.Puffiness end) end
					end
					local okAdd = pcall(function() hum:AddAccessory(accessory) end)
					if not okAdd or accessory.Parent ~= template then
						pcall(function() Fn.attachByAttachments(template, accessory) end)
					end
					present[accessory.Name] = true
					added = added + 1
				else
					pcall(function() accessory:Destroy() end)
				end
			end
			if loaded and loaded ~= accessory then pcall(function() loaded:Destroy() end) end
		end
	end
	return added
end

function Fn.buildTemplate(desc, rig, char)
	local template, mode = Fn.templateFromDescription(desc, rig), "model"
	if template then
		local okAcc, expected = pcall(function() return desc:GetAccessories(true) end)
		local actual = 0
		for _, item in ipairs(template:GetDescendants()) do
			if item:IsA("Accessory") then actual = actual + 1 end
		end
		if okAcc and type(expected) == "table" and actual < #expected then
			Fn.ensureDescriptionAccessories(template, desc)
		end
	end
	if not template then
		template, mode = Fn.templateFromAssets(desc, char), "assets"
		if template then Fn.ensureDescriptionAccessories(template, desc) end
	end
	if not template then return nil end

	Fn.prepShell(template)
	Fn.preload(template)
	return template, mode
end

function Fn.evictBuilds()
	while #BuildOrder > Fn.MAX_BUILDS do
		local victim
		for i, id in ipairs(BuildOrder) do
			local b = Build[id]
			if b and b.state ~= "building" and b.template ~= State.template then
				victim = i
				break
			end
		end
		if not victim then return end
		local id = table.remove(BuildOrder, victim)
		local b = Build[id]
		Build[id] = nil
		if b and b.template then pcall(function() b.template:Destroy() end) end
	end
end

function Fn.ensureBuild(entry)
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum then return nil end
	local rig = hum.RigType

	local b = Build[entry.id]
	if b and b.rig == rig and b.state ~= "failed" then return b end
	if b then
		local i = table.find(BuildOrder, entry.id)
		if i then table.remove(BuildOrder, i) end
		if b.template and b.template ~= State.template then
			pcall(function() b.template:Destroy() end)
		end
	end

	b = { state = "building", rig = rig }
	Build[entry.id] = b
	BuildOrder[#BuildOrder + 1] = entry.id

	task.spawn(function()
		local ok, t, mode = pcall(Fn.buildTemplate, entry.desc, rig, char)
		if ok and t then
			b.template, b.mode, b.state = t, mode, "ready"
		else
			b.state = "failed"
		end
		Fn.evictBuilds()
	end)
	return b
end

local All = { on = false, announce = false }
local Assign = {}
local GH = { run = true, ghosts = {} }

function UI.entryFor(uid)
	uid = tonumber(uid)
	if not uid then return nil end
	if uid == LocalPlayer.UserId then return State.copyEntry end
	local a = Assign[uid]
	if a then return a end
	if All.on and current and Players.GetPlayerByUserId(Players, uid) then return current end
	return nil
end

do
	local ghosts, tpls = GH.ghosts, {}

	local function unmountG(plr)
		local g = ghosts[plr]
		if not g then return end
		ghosts[plr] = nil
		if g.shell then pcall(function() g.shell:Destroy() end) end
		for inst, t in pairs(g.hidden) do
			if inst.Parent then pcall(function() inst.Transparency = t end) end
		end
	end

	local function mountG(plr, template, entry)
		local char = plr.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if not hrp then return false end
		unmountG(plr)

		local shell = template:Clone()
		shell.Name = SHELL_NAME
		local sRoot = shell:FindFirstChild("HumanoidRootPart")
		if not sRoot then
			shell:Destroy()
			return false
		end

		local g = {
			char = char, shell = shell, sRoot = sRoot, entryId = entry.id, entry = entry,
			list = Rig.pairs(char, shell), offset = Rig.offset(char, shell),
			hidden = {}, scan = os.clock(), mirror = {}, animActive = false, c0Dirty = false,
			sAnimator = Rig.animator(shell),
		}
		sRoot.Anchored = true
		shell.PrimaryPart = sRoot
		shell:PivotTo(hrp.CFrame * g.offset)
		Rig.parts(shell)

		ghosts[plr] = g
		shell.Parent = workspace.CurrentCamera or workspace
		Fn.hideReal(char, g.hidden)

		if All.announce and All.on then
			All.announce = false
			Fn.setStatus(L("setOthersMsg"), T.green)
		end
		if GH.onMounted then pcall(GH.onMounted, plr, entry) end
		return true
	end

	local function stepG()
		if next(ghosts) == nil then return end
		local want = workspace.CurrentCamera or workspace
		local now = os.clock()
		for plr, g in pairs(ghosts) do
			local char = g.char
			local hrp = char and char.Parent and char:FindFirstChild("HumanoidRootPart")
			if not hrp or plr.Character ~= char then
				unmountG(plr)
			else
				if g.shell.Parent ~= want then
					pcall(function() g.shell.Parent = want end)
				end
				for inst in pairs(g.hidden) do
					if inst.Parent and inst.Transparency ~= 1 then inst.Transparency = 1 end
				end
				g.sRoot.CFrame = hrp.CFrame * g.offset
				g.animActive = Rig.mirror(char, g.sAnimator, g.mirror, nil)
				if g.animActive then
					if g.c0Dirty then
						Rig.reset(g.list)
						g.c0Dirty = false
					end
				else
					Rig.pose(g.list)
					g.c0Dirty = true
				end
				if now - g.scan > 0.3 then
					g.scan = now
					Fn.hideReal(char, g.hidden)
				end
			end
		end
	end
	track(RunService.RenderStepped:Connect(stepG))

	local function evictT()
		local n = 0
		for _ in pairs(tpls) do n = n + 1 end
		while n > 8 do
			local vk, vu
			for k, t in pairs(tpls) do
				if t.state ~= "building" and (not vu or t.used < vu) then vk, vu = k, t.used end
			end
			if not vk then return end
			local t = tpls[vk]
			tpls[vk] = nil
			if t.model then pcall(function() t.model:Destroy() end) end
			n = n - 1
		end
	end

	local function templateFor(entry, rig)
		local key = tostring(entry.id) .. ":" .. tostring(rig)
		local t = tpls[key]
		if t then
			t.used = os.clock()
			if t.state == "ready" then return t.model end
			if t.state == "failed" and os.clock() - t.time > 6 then
				tpls[key] = nil
			else
				return nil
			end
		end
		t = { state = "building", time = os.clock(), used = os.clock() }
		tpls[key] = t
		task.spawn(function()
			local m = Fn.templateFromDescription(entry.desc, rig)
			if m and GH.run then
				Fn.prepShell(m)
				Fn.preload(m)
				t.model, t.state = m, "ready"
			else
				if m then pcall(function() m:Destroy() end) end
				t.state, t.time = "failed", os.clock()
				Fn.setStatus(L("noAvatarShellFor") .. tostring(entry.name) .. ".", T.warn)
			end
		end)
		evictT()
		return nil
	end

	local function ensure(plr)
		if plr == LocalPlayer then return end
		local entry = UI.entryFor(plr.UserId)
		local g = ghosts[plr]
		if not entry then
			if g then unmountG(plr) end
			return
		end
		local char = plr.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if not hum or not hrp then return end
		if g and g.char == char and g.entryId == entry.id and g.shell.Parent then return end
		local tpl = templateFor(entry, hum.RigType)
		if not tpl then return end
		pcall(mountG, plr, tpl, entry)
	end

	GH.unmount = unmountG
	GH.ensure = ensure

	function GH.ensureAll()
		for _, p in ipairs(Players:GetPlayers()) do ensure(p) end
	end

	function GH.shutdown()
		GH.run = false
		for plr in pairs(ghosts) do unmountG(plr) end
		for k, t in pairs(tpls) do
			if t.model then pcall(function() t.model:Destroy() end) end
			tpls[k] = nil
		end
	end

	local function hookPlayer(plr)
		if plr == LocalPlayer then return end
		track(plr.CharacterAdded:Connect(function()
			unmountG(plr)
		end))
	end
	for _, p in ipairs(Players:GetPlayers()) do hookPlayer(p) end
	track(Players.PlayerAdded:Connect(hookPlayer))
	track(Players.PlayerRemoving:Connect(function(p)
		unmountG(p)
	end))

	task.spawn(function()
		while GH.run do
			GH.ensureAll()
			task.wait(0.5)
		end
	end)
end

