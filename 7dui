function Fn.indexOf(list, id)
	for i, e in ipairs(list) do
		if e.id == id then return i end
	end
end

function Fn.addTo(listName)
	if not current then Fn.setStatus(L("firstSearchMsg"), T.warn) return end
	local list = data[listName]
	if Fn.indexOf(list, current.id) then
		Fn.setStatus(listName == "saved" and L("alreadySavedMsg") or L("alreadyFavsMsg"), T.warn)
		return
	end
	table.insert(list, { id = current.id, name = current.name, display = current.display })
	Fn.saveData()
	Fn.refreshList()
	Fn.setStatus((listName == "saved" and L("savedMsg") or L("favMsg")) .. current.name, T.green)
end

function Fn.removeFrom(listName, id)
	local i = Fn.indexOf(data[listName], id)
	if i then
		table.remove(data[listName], i)
		Fn.saveData()
		Fn.refreshList()
		Fn.setStatus(L("removedMsg"), IC.soft)
	end
end

