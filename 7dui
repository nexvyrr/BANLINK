do
	local GuiService = game:GetService("GuiService")
	local StarterGui = game:GetService("StarterGui")
	local H = { run = true, hooked = {}, lastKey = "", lastT = 0, recent = {} }
	UI.InspectHook = H
	local DEBUG = false
	local hasCC = type(checkcaller) == "function"

	local function note(text)
		if not DEBUG then return end
		task.defer(function()
			pcall(function()
				StarterGui:SetCore("SendNotification", { Title = "Perfil", Text = text, Duration = 5 })
			end)
		end)
	end

	local function report(method, arg1, redirected)
		local key = method .. tostring(arg1)
		local now = os.clock()
		if key == H.lastKey and now - H.lastT < 0.5 then return end
		H.lastKey, H.lastT = key, now
		note(method .. " -> " .. tostring(arg1) .. (redirected and " (cambiado)" or " (sin cambio)"))
	end

	function H.nameOf(uid)
		if uid == LocalPlayer.UserId then return LocalPlayer.Name end
		local p = Players:GetPlayerByUserId(uid)
		return p and p.Name
	end

	function H.showFor(uid, e)
		e = e or UI.entryFor(uid)
		if not (e and e.id ~= uid) then return false end
		H.lastShow = os.clock()
		H.recent[e.id] = os.clock()
		if H.origUid then
			local ok = pcall(H.origUid, GuiService, e.id)
			if ok then return true end
		end
		local nm = e.name
		if not (e.desc and nm) then return false end
		local okC, desc = pcall(function() return e.desc:Clone() end)
		if not okC or not desc then desc = e.desc end
		local f = H.origDesc or function(_, d, n)
			GuiService:InspectPlayerFromHumanoidDescription(d, n)
		end
		return pcall(f, GuiService, desc, nm)
	end

	function H.showOwn(ce)
		return H.showFor(LocalPlayer.UserId, ce)
	end

	function H.ownInspect(method, ...)
		if method == "InspectPlayerFromHumanoidDescription" then return false end
		local uid = tonumber((...))
		if not uid then return false end
		return H.showFor(uid)
	end

	local function entryForName(name)
		if type(name) ~= "string" then return nil end
		if name == LocalPlayer.Name or name == LocalPlayer.DisplayName then
			return State.copyEntry
		end
		for _, p in ipairs(Players.GetPlayers(Players)) do
			if p.Name == name or p.DisplayName == name then
				return UI.entryFor(p.UserId)
			end
		end
		return nil
	end

	local function handle(method, args)
		if not H.run then return false end
		if method == "InspectPlayerFromHumanoidDescription" then
			local e = entryForName(args[2])
			report(method, args[2], e ~= nil)
			if e then
				args[1] = e.desc
				if args[2] ~= LocalPlayer.Name and args[2] ~= LocalPlayer.DisplayName then
					args[2] = e.display or e.name
				end
				return true
			end
			return false
		end
		local uid = tonumber(args[1])
		if not uid then return false end
		local now = os.clock()
		local rc = H.recent[uid]
		if rc and now - rc < 0.4 then return false end
		local e = UI.entryFor(uid)
		report(method, uid, e ~= nil)
		if e and e.id ~= uid then
			H.recent[e.id] = now
			args[1] = e.id
			return true
		end
		return false
	end

	local function handlePlayers(method, args)
		if not H.run then return false end
		local uid = tonumber(args[1])
		if not uid then return false end
		local e = UI.entryFor(uid)
		if e and e.id ~= uid then
			args[1] = e.id
			return true
		end
		return false
	end

	local function rewriteUrl(url)
		local out = url:gsub("(/users/)(%d+)(/[%a%-]+)", function(a, id, suffix)
			if suffix == "/avatar" or suffix == "/currently-wearing" then
				local e = UI.entryFor(id)
				if e and e.id ~= tonumber(id) then return a .. tostring(e.id) .. suffix end
			end
			return nil
		end)
		return out
	end

	local function hookPlayersNameCalls()
		pcall(function()
			local old
			old = hookfunction(Players.GetNameFromUserIdAsync, newcclosure(function(self, userId, ...)
				if H.run and State.copyEntry and userId == LocalPlayer.UserId
					and not (hasCC and checkcaller()) then
					return State.copyEntry.name
				end
				return old(self, userId, ...)
			end))
		end)
		pcall(function()
			local old
			old = hookfunction(Players.GetUserIdFromNameAsync, newcclosure(function(self, name, ...)
				if H.run and State.copyEntry and not (hasCC and checkcaller())
					and (name == LocalPlayer.Name or name == LocalPlayer.DisplayName) then
					return State.copyEntry.id
				end
				return old(self, name, ...)
			end))
		end)
	end
	hookPlayersNameCalls()

	local METHODS = {
		"InspectPlayerFromUserId",
		"InspectPlayerFromUserIdWithCtx",
		"InspectPlayerFromHumanoidDescription",
	}

	for _, name in ipairs(METHODS) do
		pcall(function()
			local fn = GuiService[name]
			local old
			old = hookfunction(fn, newcclosure(function(self, ...)
				if self == GuiService and H.run then
					if H.ownInspect(name, ...) then return end
					local n = select("#", ...)
					local args = { ... }
					local okH, changed = pcall(handle, name, args)
					if okH and changed then
						return old(self, table.unpack(args, 1, n))
					end
				end
				return old(self, ...)
			end))
			if name == "InspectPlayerFromHumanoidDescription" then H.origDesc = old end
			if name == "InspectPlayerFromUserId" then H.origUid = old end
			H.hooked[name] = true
		end)
	end

	do
		local lastEvt = 0
		for _, evName in ipairs({ "InspectPlayerFromUserIdWithCtxRequest", "InspectPlayerFromUserIdRequest" }) do
			pcall(function()
				local sig = GuiService[evName]
				track(sig:Connect(function(uid)
					uid = tonumber(uid)
					if not H.run or not uid then return end
					local e = UI.entryFor(uid)
					if not e or e.id == uid then return end
					local now = os.clock()
					if now - lastEvt < 0.6 or now - (H.lastShow or 0) < 0.6 then return end
					lastEvt = now
					task.defer(function()
						pcall(function() GuiService:CloseInspectMenu() end)
						task.wait(0.15)
						H.showFor(uid, e)
					end)
				end))
				H.hooked["ev_" .. evName] = true
			end)
		end
	end

	local NC = {
		InspectPlayerFromUserId = "gui",
		InspectPlayerFromUserIdWithCtx = "gui",
		InspectPlayerFromHumanoidDescription = "gui",
		GetHumanoidDescriptionFromUserId = "pl",
		GetCharacterAppearanceInfoAsync = "pl",
		GetCharacterAppearanceAsync = "pl",
	}
	pcall(function()
		local old
		old = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
			local m = getnamecallmethod()
			local kind = NC[m]
			if kind and H.run then
				local go = false
				if kind == "gui" then
					go = self == GuiService
				elseif self == Players and hasCC then
					go = not checkcaller()
				end
				if go then
					if kind == "gui" and H.ownInspect(m, ...) then return end
					local n = select("#", ...)
					local args = { ... }
					local okH, changed
					if kind == "gui" then
						okH, changed = pcall(handle, m, args)
					else
						okH, changed = pcall(handlePlayers, m, args)
					end
					if setnamecallmethod then setnamecallmethod(m) end
					if okH and changed then
						return old(self, table.unpack(args, 1, n))
					end
				end
			end
			return old(self, ...)
		end))
		H.hooked.namecall = true
	end)

	if hasCC then
		pcall(function()
			local fn = HttpService.RequestInternal
			local old
			old = hookfunction(fn, newcclosure(function(self, opts, ...)
				if H.run and type(opts) == "table" and not checkcaller() then
					local url = opts.Url
					if type(url) == "string" and url:find("avatar", 1, true) then
						local localIdStr = tostring(LocalPlayer.UserId)
						if State.copyEntry and url:find(localIdStr, 1, true) then
							local ce = State.copyEntry
							local newUrl = url:gsub(localIdStr, tostring(ce.id))
							if newUrl ~= url then
								local copy = {}
								for k, v in pairs(opts) do copy[k] = v end
								copy.Url = newUrl
								return old(self, copy, ...)
							end
						end
						local okR, new = pcall(rewriteUrl, url)
						if okR and type(new) == "string" and new ~= url then
							local copy = {}
							for k, v in pairs(opts) do copy[k] = v end
							copy.Url = new
							return old(self, copy, ...)
						end
					end
				end
				return old(self, opts, ...)
			end))
			H.hooked.http = true
		end)
	end

	local function rewriteThumbUrl(img)
		if type(img) ~= "string" or img == "" then return nil end
		local localIdStr = tostring(LocalPlayer.UserId)
		if not img:find(localIdStr, 1, true) then return nil end
		if not State.copyEntry then return nil end
		local newImg = img:gsub(localIdStr, tostring(State.copyEntry.id))
		if newImg ~= img then return newImg end
		return nil
	end

	task.spawn(function()
		while H.run do
			task.wait(1)
			if not H.run then break end
			if State.copyEntry then
				local function scanGui(root)
					if not root then return end
					local ok, list = pcall(function() return root:GetDescendants() end)
					if not ok then return end
					for _, d in ipairs(list) do
						if (d:IsA("ImageLabel") or d:IsA("ImageButton")) and not d:IsDescendantOf(gui) then
							local repl = rewriteThumbUrl(d.Image)
							if repl then
								pcall(function() d.Image = repl end)
							end
						end
					end
				end
				pcall(scanGui, LocalPlayer:FindFirstChildOfClass("PlayerGui"))
				local okCG, cg = pcall(function() return game:GetService("CoreGui") end)
				if okCG and cg then pcall(scanGui, cg) end
			end
		end
	end)

	if next(H.hooked) == nil then
		task.defer(function()
			Fn.setStatus(L("noHookMsg"), T.warn)
		end)
	end
end

