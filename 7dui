	end

	function FH.showTab()
		dockToken = dockToken + 1
		local vp = UI.viewport()
		local cx = floatRoot.Position.X.Offset + FS / 2
		local cy = floatRoot.Position.Y.Offset + FS / 2
		local left = cx < vp.X / 2
		cy = math.clamp(cy, 30, math.max(30, vp.Y - 30))
		dock.AnchorPoint = Vector2.new(left and 0 or 1, 0.5)
		dock.Position = UDim2.fromOffset(left and 0 or vp.X, cy)
		dockScale.Scale = 0
		dock.Visible = true
		tween(dockScale, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 })
	end

	function FH.hideTab()
		dockToken = dockToken + 1
		local my = dockToken
		if not dock.Visible then return end
		tween(dockScale, TweenInfo.new(0.16, Enum.EasingStyle.Quint, Enum.EasingDirection.In), { Scale = 0 }).Completed:Connect(function()
			if dockToken == my then dock.Visible = false end
		end)
	end

	function FH.onOpen()
		FH.tweenBtn(TI_FLOAT_OUT, 0)
		FH.hideTab()
	end

	function FH.hide()
		FH.hidden = true
		tween(floatScale, TI_FLOAT_OUT, { Scale = 0 })
		tween(FH.scale, TI_FLOAT_OUT, { Scale = 0 }).Completed:Connect(function()
			if FH.hidden then floatRoot.Visible = false end
		end)
		FH.showTab()
