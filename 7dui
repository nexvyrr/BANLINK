do
	local Thumbs = {
		rec = {},
		hooked = {},
		watching = false,
		active = false,
		run = true,
	}
	UI.Thumbs = Thumbs

	local function swapped(img)
		if type(img) ~= "string" or img == "" then return nil end
		local uid, kind
		if img:find("rbxthumb://", 1, true) then
			if not img:find("type=Avatar", 1, true) then return nil end
			uid = tonumber(img:match("[&?]id=(%d+)"))
			kind = 1
		elseif img:find("thumbnail", 1, true) then
			uid = tonumber(img:match("[Uu]ser[Ii]d=(%d+)"))
			kind = 2
			if not uid then
				uid = tonumber(img:match("/users/(%d+)/"))
				kind = 3
			end
		end
		if not uid then return nil end
		local e = UI.entryFor(uid)
		if not e or e.id == uid then return nil end
		local cid = e.id
		if kind == 1 then
			return (img:gsub("([&?]id=)%d+", function(p) return p .. cid end, 1))
		elseif kind == 2 then
			return (img:gsub("([Uu]ser[Ii]d=)%d+", function(p) return p .. cid end, 1))
		end
		return (img:gsub("(/users/)%d+", function(p) return p .. cid end, 1))
	end

	local function process(obj)
		local img = obj.Image
		if type(img) ~= "string" then return end
		local rec = Thumbs.rec[obj]
		if rec and rec.last == img then
			local new2 = swapped(rec.orig)
			if new2 then
				if new2 ~= img then
					rec.last = new2
					pcall(function() obj.Image = new2 end)
				end
			else
				Thumbs.rec[obj] = nil
				pcall(function() obj.Image = rec.orig end)
			end
			return
		end
		if rec then Thumbs.rec[obj] = nil end
		local new2 = swapped(img)
		if new2 and new2 ~= img then
			Thumbs.rec[obj] = { orig = img, last = new2 }
			pcall(function() obj.Image = new2 end)
		end
	end

	local function hook(obj)
		if Thumbs.hooked[obj] or obj:IsDescendantOf(gui) then return end
		Thumbs.hooked[obj] = obj:GetPropertyChangedSignal("Image"):Connect(function()
			if Thumbs.active or Thumbs.rec[obj] then pcall(process, obj) end
		end)
		if Thumbs.active then pcall(process, obj) end
	end

	local function sweep()
		local snap = {}
		for obj in pairs(Thumbs.hooked) do snap[#snap + 1] = obj end
		for i, obj in ipairs(snap) do
			if not Thumbs.run then return end
			local c = Thumbs.hooked[obj]
			if c then
				if obj:IsDescendantOf(game) then
					pcall(process, obj)
				else
					pcall(function() c:Disconnect() end)
					Thumbs.hooked[obj] = nil
					Thumbs.rec[obj] = nil
				end
			end
			if i % 300 == 0 then task.wait() end
		end
	end

	local function ensureWatch()
		if Thumbs.watching then return end
		Thumbs.watching = true
		local roots = {}
		local okC, cg = pcall(function() return game:GetService("CoreGui") end)
		if okC and cg then roots[#roots + 1] = cg end
		local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
		if pg then roots[#roots + 1] = pg end
		for _, root in ipairs(roots) do
			pcall(function()
				track(root.DescendantAdded:Connect(function(d)
					if d:IsA("ImageLabel") or d:IsA("ImageButton") then pcall(hook, d) end
				end))
			end)
			task.spawn(function()
				local okD, list = pcall(function() return root:GetDescendants() end)
				if not okD then return end
				for i, d in ipairs(list) do
					if not Thumbs.run then return end
					if d:IsA("ImageLabel") or d:IsA("ImageButton") then pcall(hook, d) end
					if i % 400 == 0 then task.wait() end
				end
			end)
		end
	end

	function Thumbs.shutdown()
		Thumbs.active = false
		Thumbs.run = false
		for obj, rec in pairs(Thumbs.rec) do
			pcall(function()
				if obj.Image == rec.last then obj.Image = rec.orig end
			end)
		end
		Thumbs.rec = {}
		for _, c in pairs(Thumbs.hooked) do pcall(function() c:Disconnect() end) end
		Thumbs.hooked = {}
	end

	task.spawn(function()
		while Thumbs.run do
			task.wait(3)
			if Thumbs.run and Thumbs.watching then pcall(sweep) end
		end
	end)

	function UI.AllSync()
		if not Thumbs.run then return end
		Thumbs.active = State.copyEntry ~= nil or next(Assign) ~= nil or (All.on and current ~= nil)
		if Thumbs.active then ensureWatch() end
		task.spawn(sweep)
	end
end

do
	local Names = { rec = {}, hooked = {}, watching = false, active = false, run = true }
	UI.Names = Names
	local hdn = {}
	local map, mapT = {}, 0

	local function computeActive()
		return State.copyEntry ~= nil or next(Assign) ~= nil or (All.on and current ~= nil)
	end

	local function getMap(force)
		local now = os.clock()
		if not force and now - mapT < 0.4 then return map end
		mapT = now
		local m = {}
		if Names.active then
			for _, p in ipairs(Players:GetPlayers()) do
				local e = UI.entryFor(p.UserId)
				if e and e.id ~= p.UserId then
					m[p.Name] = e.name
					m["@" .. p.Name] = "@" .. e.name
					m[p.DisplayName] = e.display or e.name
				end
			end
		end
		map = m
		return m
	end

	local function transform(txt, m)
		local keys = {}
		for k in pairs(m) do
			if #k >= 3 then keys[#keys + 1] = k end
		end
		if #keys == 0 then return nil end
		table.sort(keys, function(a, b) return #a > #b end)
		local out, slots = txt, {}
		for _, k in ipairs(keys) do
			if out:find(k, 1, true) then
				slots[#slots + 1] = m[k]
				local tag = "\1" .. #slots .. "\2"
				out = (out:gsub((k:gsub("%p", "%%%0")), tag))
			end
		end
		if #slots == 0 then return nil end
		out = (out:gsub("\1(%d+)\2", function(i) return slots[tonumber(i)] end))
		return out
	end

	local function process(obj)
		local txt = obj.Text
		if type(txt) ~= "string" or txt == "" then return end
		local m = getMap()
		local rec = Names.rec[obj]
