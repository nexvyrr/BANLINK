						pcall(function() hum.DisplayName = dn end)
					end
				elseif hdn[hum] ~= nil then
					local orig = hdn[hum]
					hdn[hum] = nil
					pcall(function() hum.DisplayName = orig end)
				end
			end
		end
		for hum in pairs(hdn) do
			if not hum.Parent then hdn[hum] = nil end
		end
	end

	function Names.sync()
		if not Names.run then return end
		Names.active = computeActive()
		getMap(true)
		if Names.active then ensureWatch() end
		pcall(applyHum)
		task.spawn(sweep)
	end

	function Names.shutdown()
		Names.active = false
		Names.run = false
		for obj, rec in pairs(Names.rec) do
			pcall(function()
				if obj.Text == rec.last then obj.Text = rec.orig end
			end)
		end
		Names.rec = {}
		for _, c in pairs(Names.hooked) do pcall(function() c:Disconnect() end) end
		Names.hooked = {}
		for hum, orig in pairs(hdn) do
			pcall(function() hum.DisplayName = orig end)
		end
		hdn = {}
	end

	local prevSync = UI.AllSync
	function UI.AllSync()
		if prevSync then prevSync() end
		Names.sync()
	end

	task.spawn(function()
		local tick = 0
		while Names.run do
			task.wait(0.5)
			if not Names.run then break end
			tick = tick + 1
			if computeActive() ~= Names.active then
				Names.sync()
			else
				pcall(applyHum)
				if Names.watching and tick % 4 == 0 then pcall(sweep) end
			end
		end
	end)
end

