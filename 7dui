		if Names.hooked[obj] or obj:IsDescendantOf(gui) then return end
		Names.hooked[obj] = obj:GetPropertyChangedSignal("Text"):Connect(function()
			if Names.active or Names.rec[obj] then pcall(process, obj) end
		end)
		if Names.active then pcall(process, obj) end
	end

	local function sweep()
		local snap = {}
		for obj in pairs(Names.hooked) do snap[#snap + 1] = obj end
		for i, obj in ipairs(snap) do
			if not Names.run then return end
			local c = Names.hooked[obj]
